{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jadhuman",
  "version": "1.0.0",
  "identifier": "id.go.jatim.jadhuman",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Jadhuman — Portal Presensi Jawa Timur",
      "width": 1280,
      "height": 800,
      "minWidth": 900,
      "minHeight": 600,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": ["icons/icon.png"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "resources": []
  }
}
