{
  "name": "jadhuman",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/api/server.ts",
    "build": "vite build && esbuild src/api/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:tools",
    "test": "npm run typecheck:all && npm run test:health",
    "test:health": "tsx tools/cek-jadhuman.mts",
    "test:deadcode": "knip --no-progress",
    "verify": "npm test && npm run test:deadcode && npm run build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:init": "tauri android init && tsx tools/patch-android-native.mts",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tsx tools/patch-android-native.mts && tauri android build --apk --target aarch64"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@tauri-apps/cli": "^2.5.0",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "esbuild": "^0.28.1",
    "knip": "^5.88.1",
    "postcss": "^8.5.16",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@keep-lts/xlsx": "^0.18.6",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "heic2any": "^0.0.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "utif": "^3.1.0"
  },
  "engines": {
    "node": "22.x"
  }
}
